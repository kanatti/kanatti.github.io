---
import PageLayout from "../../layouts/Page.astro";
import PageWrapper from "../../components/PageWrapper.astro";
import { getAllPosts } from "../../utils";
import { seriesInfo } from "../../data/series";

const allPosts = await getAllPosts();

const seriesData = Object.entries(seriesInfo)
	.map(([slug, info]) => {
		const count = allPosts.filter((post) => post.data.series === slug).length;
		return { slug, ...info, count };
	})
	.filter((s) => s.count > 0);
---

<PageLayout title="Series">
	<PageWrapper currentPage="series">
		<div class="max-w-[640px] py-8">
			<h1 class="text-[22px] font-medium">Series</h1>
			<ul class="mt-6">
				{seriesData.map((s) => (
					<li class="flex items-baseline gap-6 border-t border-rule py-2.5">
						<p class="min-w-0 flex-1 text-[14px] leading-relaxed">
							<a href={`/series/${s.slug}`} class="font-medium hover:underline">{s.title}</a>
							<span class="ml-1.5 text-ink-dim">{s.description}</span>
						</p>
						<span class="num shrink-0 text-[12px] text-ink-dim">{s.count} post{s.count !== 1 ? "s" : ""}</span>
					</li>
				))}
			</ul>
		</div>
	</PageWrapper>
</PageLayout>
