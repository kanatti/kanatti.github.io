---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/Page.astro";
import PageWrapper from "../components/PageWrapper.astro";
import PostPreview from "../components/PostPreview.astro";

const posts = (await getCollection("post", ({ data }) => !data.draft)).sort(
	(a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);

---

<PageLayout
	title="Balagopal Kanattil"
	description="Software engineer working on databases and distributed systems"
>
	<PageWrapper currentPage="home" socials>
		<!-- the same columns as a post: text on the left, the margin on the right -->
		<header class="grid grid-cols-1 py-8 lg:grid-cols-[minmax(0,640px)_300px] lg:gap-x-12">
			<div>
				<h1 class="text-[22px] font-medium">Balagopal Kanattil Shaji</h1>
				<div class="mt-3 space-y-3 text-[15px] leading-relaxed">
					<p>
						Hi, I'm a self-taught developer with a formal education in Physics from IIT Bombay.
						I work as a Software Engineer at Amazon, on databases and distributed systems.
						I grew up in Kerala, a small state on India's southwest coast known for its food, monsoons and backwaters.
					</p>
					<p>
						When not coding, I'm sleeping, cooking, or reading manga and sci-fi. I'm a big fan of horror,
						particularly Junji Ito and H.P. Lovecraft, and I've recently got into bouldering.
					</p>
				</div>
			</div>
		</header>

		<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,640px)_300px] lg:gap-x-12">
			<div>
				<section class="pb-8">
					<div class="mb-2 flex items-baseline justify-between">
						<h2 class="text-[12px] font-medium uppercase tracking-wide text-ink-dim">Recent posts</h2>
						<a href="/posts" class="text-[12px] text-ink-dim hover:text-ink hover:underline">all posts</a>
					</div>
					<ul>
						{posts.slice(0, 5).map((post) => <PostPreview post={post} />)}
					</ul>
				</section>
			</div>
		</div>
	</PageWrapper>
</PageLayout>
