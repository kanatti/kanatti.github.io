---
import type { CollectionEntry } from "astro:content";
import PageWrapper from "../components/PageWrapper.astro";
import { seriesInfo } from "../data/series";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { title, publishDate, series: seriesSlug, seriesOrder } = post.data;
const series = seriesSlug ? seriesInfo[seriesSlug] : null;
const date = new Date(publishDate).toISOString().slice(0, 10);
---

<PageWrapper>
	<!-- the lab page's header: title and lede in the 640 px column, the margin beside it -->
	<header class="grid grid-cols-1 pt-8 pb-3 lg:grid-cols-[minmax(0,640px)_300px] lg:gap-x-12">
		<div>
			<p class="text-[12px] text-ink-dim">
				<time datetime={publishDate} class="num">{date}</time>
				{series && seriesOrder && (
					<span> · part {seriesOrder} of <a href={`/series/${seriesSlug}`} class="underline hover:text-ink">{series.title}</a></span>
				)}
			</p>
			<h1 class="mt-2 text-[22px] font-medium">{title}</h1>
		</div>
	</header>
	<!-- prose keeps to the 640 px column; a lab island (astro-island) spans the column and the margin -->
	<article class="post-body pb-10">
		<div class="post-flow space-y-3 text-[15px] leading-relaxed">
			<slot />
		</div>
	</article>
</PageWrapper>

<style is:global>
	/* the 640 px column of the header's grid: minmax(0, 640px) beside a 48 px gap and the 300 px margin */
	@media (min-width: 1024px) {
		.post-flow > :not(astro-island) { max-width: min(640px, calc(100% - 348px)); }
	}
	/* prose styles stop at a lab island, which brings its own */
	.post-body h2:not(astro-island *) { font-size: 17px; font-weight: 500; line-height: 1.35; padding-top: 1.5rem; }
	.post-body h3:not(astro-island *) { font-size: 15px; font-weight: 500; padding-top: 1rem; }
	.post-body a:not(astro-island *) { text-decoration: underline; }
	.post-body ul:not(astro-island *) { list-style: disc; padding-left: 1.25rem; }
	.post-body ol:not(astro-island *) { list-style: decimal; padding-left: 1.25rem; }
	.post-body :not(pre) > code:not(astro-island *) { background: var(--color-sunken); border-radius: 2px; padding: 0 4px; }
	.post-body blockquote:not(astro-island *) { border-left: 2px solid var(--color-rule-strong); padding-left: 12px; color: var(--color-ink-dim); }
</style>
