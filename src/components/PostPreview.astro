---
import type { CollectionEntry } from "astro:content";

interface Props {
    post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const date = new Date(post.data.publishDate).toISOString().slice(0, 10);
---

<!-- one row: title, its description inline after it in dim, the date at the right -->
<li class="flex items-baseline gap-6 border-t border-rule py-2.5">
    <p class="min-w-0 flex-1 text-[14px] leading-relaxed">
        <a href={`/posts/${post.slug}`} class="font-medium text-ink hover:underline">{post.data.title}</a>
        <span class="ml-1.5 text-ink-dim">{post.data.description}</span>
    </p>
    <time datetime={post.data.publishDate} class="num shrink-0 text-[12px] text-ink-dim">{date}</time>
</li>
